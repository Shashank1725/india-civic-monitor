# ─────────────────────────────────────────────────────────────────────────────
# India Civic Disruption Monitoring System — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to Git.
# ─────────────────────────────────────────────────────────────────────────────

# ── DATABASE ─────────────────────────────────────────────────────────────────
# SQLite (default — no server required):
DATABASE_URL=sqlite:///./india_civic_monitor.db

# PostgreSQL (uncomment and fill when ready to switch):
# DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/india_civic_monitor

# ── DATA PATHS ───────────────────────────────────────────────────────────────
# Folder containing the BBMP CSV files (relative to the repo root)
DATASET_DIR=./Dataset

# ── SNAPSHOT RESTORE (production) ────────────────────────────────────────────
# Pre-built DB snapshot restored at boot when the local DB is empty
# (Render free instances wipe their filesystem on every sleep/restart).
# Build one with: python scripts/package_db_snapshot.py  (see DEPLOY.md)
#DB_SNAPSHOT_URL=https://github.com/<user>/<repo>/releases/download/v1/india_civic_monitor.db.zst
#DB_SNAPSHOT_SHA256=

# ── API CONFIG ────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=true

# ── INGESTION CONFIG ──────────────────────────────────────────────────────────
# Max records per DB batch insert (tune for memory vs. speed)
BATCH_SIZE=10000
